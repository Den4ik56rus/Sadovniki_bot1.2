# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# === Database (Docker internal — не менять DB_HOST) ===
DB_HOST=db
DB_PORT=5432
DB_NAME=garden_bot
DB_USER=bot_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# === OpenAI ===
OPENAI_API_KEY=sk-your-key
OPENAI_MODEL_CONSULTATION=gpt-4o-mini
OPENAI_MODEL_ARTICLE=gpt-4o-mini
OPENAI_MODEL_CLASSIFICATION=gpt-4o-mini
OPENAI_MODEL_UTILITY=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# === Администраторы (Telegram user IDs через запятую) ===
ADMIN_IDS=123456789

# === API сервер (внутри контейнера) ===
API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://YOUR_SERVER_IP

# === WebApp ===
WEBAPP_URL=
WEBAPP_ORIGIN=*

# === QueryRouter (опционально) ===
QUERYROUTER_API_KEY=

# === YooKassa платежи ===
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_TEST_MODE=true
YOOKASSA_RETURN_URL=https://t.me/your_bot
YOOKASSA_WEBHOOK_URL=http://YOUR_SERVER_IP/api/webhooks/yookassa
YOOKASSA_SEND_RECEIPT=true
YOOKASSA_TAX_SYSTEM_CODE=1
